# 複製成 .env.local 填入真正的值（.env.local 不會被上傳）
# 部署到 Vercel 時，把同樣的變數填到 Vercel 專案的 Settings → Environment Variables

# ── Gemini 金鑰池（伺服器端，不會出現在網頁裡）──
# 申請：https://aistudio.google.com/apikey
# 方式一（最簡單）：所有功能共用一串 key。JSON 陣列或用逗號隔開都可以
GEMINI_API_KEYS=
# 方式二（可選）：某個功能專用的一串 key，沒設就用上面那串。功能名稱：
#   RECOGNIZE（拍照辨識） EXPLAIN（看不懂題目） SOLVE（解題） ENRICH（知識點補充）
#   PRACTICE（出練習題） ASK（追問） DISTILL（學習背景分析）
# GEMINI_API_KEYS_RECOGNIZE=
# GEMINI_API_KEYS_SOLVE=
# 舊的單一 key 仍可用（沒設 GEMINI_API_KEYS 時才會用到）
GEMINI_API_KEY=

# ── 每個功能用哪些模型（可選，沒設就用程式內建順序）──
# 由前到後依序嘗試；某個模型在所有 key 都額度用完或塞車時，才換下一個
# GEMINI_MODELS_RECOGNIZE=gemini-3.1-flash-lite,gemini-3.5-flash
# GEMINI_MODELS_SOLVE=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview
# 解題的思考深度（MINIMAL / LOW / MEDIUM / HIGH）；不設就用模型預設
# SOLVE_THINKING_LEVEL=

# ── 其他伺服器端設定 ──
# Firebase 服務帳戶金鑰 JSON（整份貼成一行），用來驗證登入與計算 AI 使用次數
FIREBASE_SERVICE_ACCOUNT=
# 每人每天可用 AI 次數（登入 / 訪客）
AI_DAILY_LIMIT_USER=30
AI_DAILY_LIMIT_GUEST=5

# ── 前端（Firebase 網頁應用程式設定，公開也沒關係）──
# 舊名稱 VITE_FIREBASE_* 仍然有效
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
